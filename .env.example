# WireGuard Agent Configuration
# Copy this file to .env and update with your values
# Then run: export $(cat .env | xargs)

# ============================================
# REQUIRED SETTINGS
# ============================================

# API Key for authentication (REQUIRED)
# Generate with: openssl rand -base64 32
# Keep this secret and secure!
API_KEY=your-secure-api-key-here-change-me

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server host address
# Use 0.0.0.0 to listen on all interfaces
# Use 127.0.0.1 to listen only on localhost
HOST=0.0.0.0

# Server port
# Default: 9999
PORT=9999

# ============================================
# WIREGUARD CONFIGURATION
# ============================================

# WireGuard interface name
# Default: wg0
WG_INTERFACE=wg0

# Path to the public key file
# Default: /etc/wireguard/publickey
PUBLIC_KEY_PATH=/etc/wireguard/publickey

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log level: debug, info, warn, error
# Default: info
LOG_LEVEL=info

# ============================================
# DOCKER/DEPLOYMENT CONFIGURATION
# ============================================

# Docker image registry
# For GitHub Container Registry: ghcr.io/yourusername
# For Docker Hub: yourdockerusername
DOCKER_REGISTRY=ghcr.io/yourusername

# Docker image name
# Default: wg-agent
IMAGE_NAME=wg-agent

# Docker image tag
# Default: latest
IMAGE_TAG=latest

# ============================================
# OPTIONAL ADVANCED SETTINGS
# ============================================

# Command timeout in seconds (for WireGuard operations)
# Default: 10
COMMAND_TIMEOUT=10

# Maximum request body size
# Default: 1MB
MAX_REQUEST_SIZE=1048576

# Enable detailed request logging
# Options: true, false
# Default: false
VERBOSE_LOGGING=false

# ============================================
# EXAMPLE USAGE
# ============================================

# For local development:
#   export $(cat .env | xargs)
#   go run main.go

# For Docker:
#   docker run --env-file .env \
#     --cap-add NET_ADMIN \
#     --cap-add SYS_MODULE \
#     -v /etc/wireguard:/etc/wireguard:ro \
#     wg-agent:latest

# For Docker Compose:
#   docker-compose up -d
#   (uses .env automatically)

# For Kubernetes:
#   kubectl create secret generic wg-agent-api-key \
#     --from-literal=api-key=$(grep API_KEY .env | cut -d '=' -f2)
